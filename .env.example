# Add values only after creating your own free Supabase project. Never commit .env.local.
# These are publishable browser configuration values, not privileged credentials.
NEXT_PUBLIC_SUPABASE_URL=
# Current Supabase projects label this a publishable key. Older projects can use
# NEXT_PUBLIC_SUPABASE_ANON_KEY instead; set one, never both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do not add a service-role key to browser code or this repository.
# Payment, OTP, and other provider credentials are intentionally not configured.
